# GitHub OAuth App credentials (create at https://github.com/settings/developers)
# Set Authorization callback URL to: http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 32+ character secret used to AES-256-GCM encrypt the HttpOnly session cookie
GITHUB_SESSION_SECRET=

# Optional public origin (defaults to the incoming request origin in development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
