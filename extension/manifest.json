{
  "manifest_version": 3,
  "name": "CPex GitHub Bridge",
  "version": "1.0.0",
  "description": "Stores GitHub credentials/.env locally inside your browser extension and bridges CPex GitHub commits securely.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CPex GitHub Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
